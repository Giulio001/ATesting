{
  "name": "aetheria-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev -w @aetheria/server\" \"npm run dev -w @aetheria/client\"",
    "build": "npm run build -w @aetheria/server && npm run build -w @aetheria/client",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/multiplayer.ts",
    "start": "npm run start -w @aetheria/server"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
